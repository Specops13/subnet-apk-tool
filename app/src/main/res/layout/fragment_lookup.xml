<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- IP membership check -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IP Membership Check"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etCheckIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="IP address (e.g. 192.168.1.50)"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etCheckCidr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="CIDR block (e.g. 192.168.1.0/24)"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check Membership"
                    android:backgroundTint="@color/accent_blue"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvLookupResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mask converter -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mask Converter"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter dotted mask (255.255.255.0) or prefix (/24 or 24)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etMaskInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="255.255.255.0  or  /24"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnConvertMask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Convert"
                    android:backgroundTint="@color/accent_blue"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvMaskResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

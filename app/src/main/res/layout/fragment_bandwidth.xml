<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="File Size (MB)"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etBwFileSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 1024"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bandwidth (Mbps)"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etBwSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 100"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Efficiency %"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etBwEff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="90"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>
                <Button
                    android:id="@+id/btnBwCalc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculate Transfer Time"
                    android:backgroundTint="@color/accent_green"
                    android:textColor="@color/bg_dark"/>
                <TextView
                    android:id="@+id/tvBwError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBwResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tvBwResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

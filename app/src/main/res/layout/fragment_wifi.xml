<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frequency (GHz)"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etWifiFreq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="2.4 or 5.8"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distance (meters)"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etWifiDist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 100"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TX Power (dBm)"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etWifiTxPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="20"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TX Gain (dBi)"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="4dp"/>
                        <EditText
                            android:id="@+id/etWifiTxGain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="0"
                            android:textColorHint="@color/text_hint"
                            android:textColor="@color/text_primary"
                            android:fontFamily="monospace"
                            android:textSize="14sp"
                            android:background="@color/input_bg"
                            android:padding="10dp"
                            android:inputType="numberDecimal"
                            android:singleLine="true"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RX Gain (dBi)"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="4dp"/>
                        <EditText
                            android:id="@+id/etWifiRxGain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="0"
                            android:textColorHint="@color/text_hint"
                            android:textColor="@color/text_primary"
                            android:fontFamily="monospace"
                            android:textSize="14sp"
                            android:background="@color/input_bg"
                            android:padding="10dp"
                            android:inputType="numberDecimal"
                            android:singleLine="true"/>
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/btnWifiCalc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculate Link Budget"
                    android:backgroundTint="@color/accent_blue"
                    android:textColor="@color/bg_dark"/>
                <TextView
                    android:id="@+id/tvWifiError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWifiResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tvWifiResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

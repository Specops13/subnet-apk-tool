<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Base Network"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etVlsmBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 10.0.0.0/16"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Requirements (Name:Hosts per line)"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etVlsmReqs"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="LAN-A:50&#10;LAN-B:25&#10;WAN-1:2"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="8dp"/>
                <Button
                    android:id="@+id/btnVlsmCalc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allocate Subnets"
                    android:backgroundTint="@color/accent_green"
                    android:textColor="@color/bg_dark"/>
                <TextView
                    android:id="@+id/tvVlsmError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVlsmResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allocation Table"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:id="@+id/tvVlsmResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Mode toggle -->
            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <RadioButton
                    android:id="@+id/rbSplit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Split (÷)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_green"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbGrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grow (↑)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent_blue"/>

            </RadioGroup>

            <!-- Label for input 1 -->
            <TextView
                android:id="@+id/tvCidrLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parent CIDR"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etSplitCidr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="e.g. 192.168.0.0/22"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="15sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/etNewPrefix"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="/prefix"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="15sp"
                    android:background="@color/input_bg"
                    android:padding="10dp"
                    android:inputType="number"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- Label for prefix field -->
            <TextView
                android:id="@+id/tvPrefixLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New subnet prefix (larger number = smaller subnets)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnSplit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Split Subnet"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/bg_dark"/>

            <TextView
                android:id="@+id/tvSplitError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="@color/accent_red"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvSplitSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Supernet info card (Grow mode only) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSupernet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Supernet"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSupernetInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:textSize="13sp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvListHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Network              |  First – Last Host      |  Hosts"
        android:textColor="@color/text_hint"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp"/>

    <ListView
        android:id="@+id/listSplitResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp"/>

</LinearLayout>
